# Copier ce fichier vers .env
# Ne jamais committer de clé réelle.

# Auth.js — générer une valeur longue et aléatoire
AUTH_SECRET="remplacer-par-une-chaine-aleatoire-longue"

# Compte de simulation affiché à la connexion
DEMO_USER_EMAIL="morel@navalsmart.local"
DEMO_USER_PASSWORD="Formation2026!"

# PostgreSQL
DATABASE_URL="postgresql://navalsmart:navalsmart@localhost:5432/navalsmart?schema=public"

# OpenAI — laisser vide pour l'analyse locale, qui ne retient qu'une citation présente dans le document
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Taille maximale d'un appel d'offres, en octets (20 Mo)
MAX_UPLOAD_BYTES="20971520"
